'use strict';

/*
 * CABO 音频层。
 * 全部由 Web Audio 实时合成，不加载任何音频文件——保持单 exe 体积，也没有素材版权负担。
 * 公开 window.CaboAudio（构造器，可传入 OfflineAudioContext 做离线渲染自检）
 * 和 window.caboAudio（游戏用的单例）。
 */
(function () {
  const STORE_KEY = 'cabo.audio.v1';
  const SILENT = 0.0001;

  const hz = (m) => 440 * Math.pow(2, (m - 69) / 12);
  const clamp = (v, lo, hi) => Math.min(hi, Math.max(lo, v));

  function mulberry32(seed) {
    let a = seed >>> 0;
    return function () {
      a = (a + 0x6d2b79f5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  /* ---------------- 偏好设置：不依赖音频引擎，页面一加载就能渲染控件 ---------------- */

  const prefs = loadPrefs();
  const widgets = [];
  let engine = null;

  function loadPrefs() {
    let s = null;
    try {
      s = JSON.parse(localStorage.getItem(STORE_KEY) || 'null');
    } catch (e) {
      s = null;
    }
    return Object.assign({ music: 0.55, sfx: 0.75, muted: false }, s || {});
  }

  function savePrefs() {
    try {
      localStorage.setItem(STORE_KEY, JSON.stringify(prefs));
    } catch (e) {
      /* 无痕模式写不进去，还有服务端兜底 */
    }
    fetch('/api/prefs', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(prefs),
    }).catch(() => {});
  }

  // localStorage 按来源隔离，而原生窗口每次端口都不同，所以真正的持久值在服务端文件里。
  // 用户已经动过控件就不再用远端覆盖，避免竞态把新值刷回去。
  let prefsTouched = false;

  fetch('/api/prefs')
    .then((r) => r.json())
    .then((r) => {
      if (prefsTouched || !r || !r.prefs) return;
      prefs.music = clamp(r.prefs.music, 0, 1);
      prefs.sfx = clamp(r.prefs.sfx, 0, 1);
      prefs.muted = !!r.prefs.muted;
      if (engine) engine.applyVolumes();
      syncWidgets();
    })
    .catch(() => {});

  function setVolume(kind, v) {
    prefsTouched = true;
    prefs[kind] = clamp(v, 0, 1);
    if (engine) engine.applyVolumes();
    syncWidgets();
    savePrefs();
  }

  function setMuted(on) {
    prefsTouched = true;
    prefs.muted = !!on;
    if (engine) engine.applyVolumes();
    syncWidgets();
    savePrefs();
  }

  /* ---------- 配乐数据：D 大调、3/4 拍「客厅圆舞曲」 ---------- */
  // 选 3/4 而不是 4/4：圆舞曲的摇曳感更贴近「记忆桌游」的调性，
  // 4/4 + 强 backbeat 会把气氛推向赌场/酒吧，那是这个项目明确避开的。
  const CHORDS = {
    D: { bass: 38, tri: [54, 57, 62], mel: [62, 66, 69, 74, 78] },
    G: { bass: 43, tri: [50, 55, 59], mel: [59, 62, 67, 71, 74] },
    Bm: { bass: 47, tri: [50, 54, 57], mel: [62, 66, 71, 74, 78] },
    A: { bass: 45, tri: [52, 57, 61], mel: [57, 61, 64, 69, 73] },
    Dsus: { bass: 38, tri: [50, 55, 57, 62], mel: [62, 64, 67, 71, 74] },
  };
  const FORM = [
    ['D', 'G', 'Bm', 'A', 'D', 'G', 'A', 'Dsus'],
    ['Bm', 'A', 'G', 'D', 'Bm', 'A', 'G', 'A'],
  ];
  const STEPS_PER_BAR = 12; // 十六分音符 × 12 = 一小节三拍
  const TOTAL_BARS = 16;

  const MOTIF = [
    [2, 3, 4, 3],
    [3, 1, 2, 0],
    [0, 2, 3, 4],
    [4, 2, 3, 1],
  ];
  const PATTERNS = [
    { st: [0, 3, 6, 9], mo: [0, 1, 2, 3] },
    { st: [0, 4, 6, 9], mo: [0, 1, 2, 3] },
    { st: [0, 3, 7, 9], mo: [0, 1, 2, 3] },
    { st: [0, 2, 4, 6, 9], mo: [0, 1, 1, 2, 3] },
    { st: [0, 3, 6], mo: [3, 2, 4] },
    { st: [0, 6], mo: [2, 3] },
  ];
  // D 大调音阶，用于把经过音吸附到调内
  const SCALE = [57, 59, 61, 62, 64, 66, 67, 69, 71, 73, 74, 76, 78, 79, 81, 83, 85, 86];

  const TEMPO = { menu: 76, table: 100, tension: 112 };
  const REV = { menu: 0.55, table: 0.34, tension: 0.2 };

  class CaboAudio {
    constructor(ctx) {
      this.ctx = ctx || new (window.AudioContext || window.webkitAudioContext)();
      this.offline = typeof this.ctx.startRendering === 'function';
      this.ok = !!this.ctx.destination;
      this.musicOn = true;
      this.mode = 'menu';
      this.bpm = TEMPO.menu;
      this.tempoTarget = TEMPO.menu;
      this.step = 0;
      this.loop = 0;
      this.plan = null;
      this.prefs = prefs;

      this._buildGraph();
      this._buildNoise();
      this._buildReverb();
      this.applyVolumes();

      if (!this.offline) {
        this.timer = setInterval(() => this._pump(), 25);
        this._pump();
      }
    }

    /* ---------------- 总线 ---------------- */

    _buildGraph() {
      const ctx = this.ctx;
      this.master = ctx.createGain();
      this.limiter = ctx.createDynamicsCompressor();
      this.limiter.threshold.value = -10;
      this.limiter.knee.value = 8;
      this.limiter.ratio.value = 5;
      this.limiter.attack.value = 0.005;
      this.limiter.release.value = 0.18;
      this.master.connect(this.limiter);
      this.limiter.connect(ctx.destination);

      this.sfxBus = ctx.createGain();
      this.musicBus = ctx.createGain();
      this.ducker = ctx.createGain();
      this.musicBus.connect(this.ducker);
      this.ducker.connect(this.master);
      this.sfxBus.connect(this.master);

      this.revIn = ctx.createGain();
      this.revIn.gain.value = 1;
      this.conv = ctx.createConvolver();
      this.revOut = ctx.createGain();
      this.revOut.gain.value = 0.9;
      this.revIn.connect(this.conv);
      this.conv.connect(this.revOut);
      this.revOut.connect(this.master);
    }

    _buildNoise() {
      const ctx = this.ctx;
      const len = Math.floor(ctx.sampleRate * 2);
      const buf = ctx.createBuffer(1, len, ctx.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
      this.noiseBuf = buf;
    }

    // 噪声 × 指数衰减 + 单极低通 = 暖色房间混响。15ms 预延迟避免糊成一团。
    _buildReverb() {
      if (!this.ctx.createConvolver) return;
      const ctx = this.ctx;
      const sr = ctx.sampleRate;
      const len = Math.floor(sr * 2.1);
      const pre = Math.floor(sr * 0.015);
      const buf = ctx.createBuffer(2, len, sr);
      for (let c = 0; c < 2; c++) {
        const d = buf.getChannelData(c);
        const seed = c * 7919;
        const rnd = mulberry32(seed);
        let lp = 0;
        for (let i = pre; i < len; i++) {
          const k = 1 - (i - pre) / (len - pre);
          lp += 0.42 * (rnd() * 2 - 1 - lp);
          d[i] = lp * Math.pow(k, 2.4);
        }
      }
      this.conv.buffer = buf;
    }

    applyVolumes() {
      const p = this.prefs;
      const m = p.muted ? 0 : 1;
      this.sfxBus.gain.value = 0.62 * m * p.sfx;
      this.musicBus.gain.value = 0.3 * m * p.music;
      this.musicOn = p.music > 0.001 && !p.muted;
    }

    duck(amount, dur) {
      if (!this.ducker) return;
      const t = this.ctx.currentTime;
      const g = this.ducker.gain;
      g.cancelScheduledValues(t);
      g.setValueAtTime(g.value, t);
      g.linearRampToValueAtTime(amount, t + 0.08);
      g.setValueAtTime(amount, t + dur);
      g.linearRampToValueAtTime(1, t + dur + 0.6);
    }

    /* ---------------- 发声基元 ---------------- */

    _route(node, o) {
      const ctx = this.ctx;
      let n = node;
      if (o.pan && ctx.createStereoPanner) {
        const p = ctx.createStereoPanner();
        p.pan.value = clamp(o.pan, -1, 1);
        n.connect(p);
        n = p;
      }
      n.connect(o.bus === 'music' ? this.musicBus : this.sfxBus);
      if (o.send > 0) {
        const g = ctx.createGain();
        g.gain.value = o.send;
        node.connect(g);
        g.connect(this.revIn);
      }
    }

    _filter(type, o) {
      const ctx = this.ctx;
      const f = ctx.createBiquadFilter();
      f.type = type;
      if (type === 'bandpass') f.Q.value = o.q || 1;
      if (o.hp) f.frequency.setValueAtTime(o.hp, o.t);
      if (o.bp) f.frequency.setValueAtTime(o.bp, o.t);
      if (o.lp) f.frequency.setValueAtTime(o.lp, o.t);
      return f;
    }

    osc(t, freq, o) {
      const ctx = this.ctx;
      const dur = o.dur === undefined ? 0.3 : o.dur;
      const peak = Math.max(SILENT * 2, o.gain === undefined ? 0.2 : o.gain);
      const src = ctx.createOscillator();
      src.type = o.type || 'sine';
      src.frequency.setValueAtTime(Math.max(1, freq), t);
      if (o.to) src.frequency.exponentialRampToValueAtTime(Math.max(1, o.to), t + (o.toDur || dur * 0.8));
      if (o.detune) src.detune.value = o.detune;

      const nodes = [src];
      if (o.hp || o.bp) nodes.push(this._filter(o.bp ? 'bandpass' : 'highpass', { t, hp: o.hp, bp: o.bp, q: o.q }));
      if (o.lp) {
        const f = this._filter('lowpass', { t, lp: o.lp, q: o.lq });
        if (o.lpTo) f.frequency.exponentialRampToValueAtTime(Math.max(60, o.lpTo), t + dur);
        nodes.push(f);
      }
      const g = ctx.createGain();
      nodes.push(g);
      for (let i = 0; i < nodes.length - 1; i++) nodes[i].connect(nodes[i + 1]);

      const a = o.attack === undefined ? 0.005 : o.attack;
      const hold = o.hold || 0;
      g.gain.setValueAtTime(SILENT, t);
      g.gain.exponentialRampToValueAtTime(peak, t + a);
      if (hold) g.gain.setValueAtTime(peak, t + a + hold);
      g.gain.exponentialRampToValueAtTime(SILENT, t + dur);

      src.start(t);
      src.stop(t + dur + 0.05);
      this._route(g, o);
      return g;
    }

    noise(t, o) {
      const ctx = this.ctx;
      const dur = o.dur === undefined ? 0.08 : o.dur;
      // 带通/高通会切掉白噪声的大部分能量，若不补偿，纸牌这一类噪声音效
      // 会比同样标称音量的振荡器音效轻约 10dB
      const kind = o.bp ? 'bandpass' : o.lp ? 'lowpass' : 'highpass';
      const q = o.q === undefined ? (kind === 'bandpass' ? 1.1 : 0.7) : o.q;
      const makeup = kind === 'bandpass' ? 1.8 + q * 1.7 : 2.6;
      const peak = Math.max(SILENT * 2, (o.gain === undefined ? 0.2 : o.gain) * makeup);
      const src = ctx.createBufferSource();
      src.buffer = this.noiseBuf;
      const nodes = [src];
      const freq = o.bp || o.lp || o.hp || 2200;
      const f = ctx.createBiquadFilter();
      f.type = kind;
      f.Q.value = q;
      f.frequency.setValueAtTime(freq, t);
      if (o.sweep) f.frequency.exponentialRampToValueAtTime(Math.max(60, o.sweep), t + dur);
      nodes.push(f);
      const g = ctx.createGain();
      nodes.push(g);
      for (let i = 0; i < nodes.length - 1; i++) nodes[i].connect(nodes[i + 1]);

      const a = o.attack === undefined ? 0.002 : o.attack;
      g.gain.setValueAtTime(SILENT, t);
      g.gain.exponentialRampToValueAtTime(peak, t + a);
      if (o.hold) g.gain.setValueAtTime(peak, t + a + o.hold);
      g.gain.exponentialRampToValueAtTime(SILENT, t + dur);

      src.start(t, Math.random() * Math.max(0.001, this.noiseBuf.duration - dur - 0.06));
      src.stop(t + dur + 0.03);
      this._route(g, o);
      return g;
    }

    // 音乐盒／木琴：基音 + 微非谐泛音 + 极短敲击瞬态
    pluck(t, midi, o) {
      o = o || {};
      const f = hz(midi);
      const g = o.gain === undefined ? 0.2 : o.gain;
      const dur = o.dur === undefined ? 0.85 : o.dur;
      const parts = o.parts || [
        [1, 1, 1],
        [2.0, 0.32, 0.6],
        [3.03, 0.14, 0.42],
        [4.76, 0.05, 0.26],
      ];
      for (const [r, ag, dg] of parts) {
        this.osc(t, f * r, {
          type: o.type || 'sine',
          gain: g * ag,
          dur: dur * dg,
          attack: 0.002,
          bus: o.bus,
          send: o.send,
          pan: o.pan,
          lp: o.lp,
        });
      }
      if (o.transient !== false) {
        this.noise(t, { dur: 0.02, gain: g * 0.42, bp: f * 3.1, q: 1.4, bus: o.bus, pan: o.pan });
      }
    }

    bell(t, midi, o) {
      o = o || {};
      const f = hz(midi);
      const g = o.gain === undefined ? 0.16 : o.gain;
      const dur = o.dur === undefined ? 1.8 : o.dur;
      for (const [r, ag, dg] of [[1, 1, 1], [2.76, 0.34, 0.62], [5.4, 0.13, 0.4], [8.93, 0.05, 0.26]]) {
        this.osc(t, f * r, {
          gain: g * ag,
          dur: dur * dg,
          attack: 0.004,
          bus: o.bus,
          send: o.send === undefined ? 0.45 : o.send,
          pan: o.pan,
        });
      }
    }

    bassNote(t, midi, o) {
      o = o || {};
      const f = hz(midi);
      const g = o.gain === undefined ? 0.26 : o.gain;
      const dur = o.dur === undefined ? 0.55 : o.dur;
      this.osc(t, f, { type: 'triangle', gain: g, dur: dur, attack: 0.006, lp: 420, lpTo: 170, bus: o.bus, send: o.send, pan: o.pan });
      this.osc(t, f * 2, { type: 'sine', gain: g * 0.22, dur: dur * 0.6, attack: 0.004, bus: o.bus, send: o.send, pan: o.pan });
    }

    thud(t, o) {
      o = o || {};
      const g = o.gain === undefined ? 0.3 : o.gain;
      this.osc(t, o.from || 165, { to: o.to || 58, dur: o.dur || 0.24, gain: g, attack: 0.003 });
      this.noise(t, { dur: 0.05, gain: g * 0.4, lp: 340, q: 0.6 });
    }

    flick(t, o) {
      // 真实纸牌甩动就是几段噪声瞬态，所以这一类音效用合成反而接近采样
      o = o || {};
      const g = o.gain === undefined ? 0.3 : o.gain;
      const bp = o.bp || 2600;
      const spots = [0, 0.013, 0.031];
      const amps = [0.55, 1, 0.4];
      for (let i = 0; i < spots.length; i++) {
        this.noise(t + spots[i], { dur: 0.035, gain: g * amps[i], bp: bp * (0.85 + i * 0.2), q: 0.9, pan: o.pan, send: o.send });
      }
    }

    whoosh(t, o) {
      o = o || {};
      this.noise(t, {
        dur: o.dur || 0.42,
        gain: o.gain === undefined ? 0.16 : o.gain,
        bp: o.from || 520,
        sweep: o.to || 2400,
        q: 0.7,
        attack: (o.dur || 0.42) * 0.45,
        pan: o.pan,
        send: o.send,
      });
    }

    sparkle(t, n, seedTint) {
      const rnd = mulberry32(((t * 1000) | 0) ^ (seedTint || 0));
      for (let i = 0; i < n; i++) {
        const at = t + rnd() * 0.95;
        this.pluck(at, 84 + Math.floor(rnd() * 12), { gain: 0.05 + rnd() * 0.05, dur: 0.4, bus: 'sfx', send: 0.5, pan: rnd() * 1.6 - 0.8 });
      }
    }

    /* ---------------- 音效 ---------------- */

    get t() {
      return this.ctx.currentTime;
    }

    play(name, arg) {
      if (!this.ok || this.ctx.state === 'closed') return;
      if (this.ctx.state === 'suspended' && !this.offline) this.ctx.resume();
      const fn = this.sfx[name];
      if (!fn) return;
      try {
        fn.call(this, this.t, arg);
      } catch (e) {
        console.warn('[cabo audio]', name, e);
      }
    }

    get sfx() {
      if (this._sfx) return this._sfx;
      const S = 'sfx';
      return (this._sfx = {
        ui(t) {
          this.osc(t, 1080, { type: 'sine', gain: 0.14, dur: 0.05, attack: 0.002, bus: S, send: 0.06 });
          this.noise(t, { dur: 0.014, gain: 0.1, hp: 2600, bus: S });
        },
        select(t, i) {
          const n = 72 + (i || 0) * 3;
          this.pluck(t, n, { gain: 0.17, dur: 0.4, bus: S, send: 0.14, lp: 3200 });
        },
        deselect(t) {
          this.pluck(t, 65, { gain: 0.2, dur: 0.26, bus: S, send: 0.1, transient: false });
        },
        // 发牌：n 次纸牌擦过，节奏带一点不均匀才像人手
        deal(t, n) {
          const c = clamp(n || 4, 1, 16);
          const rnd = mulberry32((t * 997) | 0);
          for (let i = 0; i < c; i++) {
            this.flick(t + i * (0.052 + rnd() * 0.022), { gain: 0.1 + rnd() * 0.06, bp: 2100 + rnd() * 1400, send: 0.1 });
          }
          this.osc(t + c * 0.055, 300, { to: 200, dur: 0.16, gain: 0.08, attack: 0.01, bus: S });
        },
        settle(t, n) {
          const c = clamp(n || 1, 1, 4);
          for (let i = 0; i < c; i++) this.flick(t + i * 0.06, { gain: 0.07, bp: 2500 });
        },
        flip(t) {
          this.flick(t, { gain: 0.2, bp: 3000, send: 0.12 });
          this.osc(t + 0.02, 640, { to: 900, dur: 0.09, gain: 0.08, attack: 0.004 });
        },
        draw(t) {
          this.whoosh(t, { dur: 0.3, gain: 0.11, from: 1600, to: 700, pan: -0.15 });
          this.flick(t, { gain: 0.13, bp: 1900 });
        },
        discard(t) {
          this.flick(t, { gain: 0.23, bp: 2300, pan: 0.1 });
        },
        place(t) {
          this.flick(t, { gain: 0.15, bp: 2600 });
          this.osc(t + 0.05, 420, { to: 300, dur: 0.12, gain: 0.11 });
        },
        take(t) {
          this.whoosh(t, { dur: 0.26, gain: 0.1, from: 900, to: 2100, pan: 0.18 });
          this.pluck(t + 0.16, 76, { gain: 0.14, dur: 0.3, send: 0.2 });
        },
        land(t) {
          this.thud(t, { gain: 0.2, from: 150, to: 62, dur: 0.2 });
          this.noise(t, { dur: 0.05, gain: 0.06, bp: 3000, q: 0.8 });
        },
        receive(t) {
          this.osc(t, 430, { to: 240, dur: 0.1, gain: 0.18, attack: 0.003 });
          this.noise(t, { dur: 0.02, gain: 0.06, hp: 3200 });
        },
        swap(t) {
          this.whoosh(t, { dur: 0.4, gain: 0.1, from: 480, to: 2300, pan: -0.75, send: 0.16 });
          this.whoosh(t + 0.09, { dur: 0.4, gain: 0.1, from: 2300, to: 620, pan: 0.75, send: 0.16 });
          this.pluck(t + 0.3, 73, { gain: 0.12, dur: 0.35, send: 0.25 });
        },
        peek(t) {
          this.pluck(t, 81, { gain: 0.15, dur: 0.7, send: 0.35, pan: -0.12 });
          this.bell(t + 0.07, 88, { gain: 0.08, dur: 1.1, send: 0.5, pan: 0.14 });
        },
        spy(t) {
          this.bell(t, 78, { gain: 0.13, dur: 1.4, send: 0.55, pan: -0.2 });
          this.osc(t, hz(78) * 1.006, { gain: 0.05, dur: 1.3, attack: 0.02, send: 0.5, pan: 0.2 });
          this.osc(t + 0.04, 110, { type: 'triangle', gain: 0.06, dur: 0.9, attack: 0.05, lp: 300 });
        },
        penalty(t) {
          this.osc(t, 200, { type: 'sawtooth', to: 118, dur: 0.42, gain: 0.22, attack: 0.004, lp: 900, lpTo: 280 });
          this.osc(t, 196, { type: 'sawtooth', to: 115, dur: 0.42, gain: 0.16, attack: 0.004, lp: 800, lpTo: 250, detune: -22 });
          this.thud(t + 0.05, { gain: 0.18, from: 120, to: 60 });
        },
        error(t) {
          this.osc(t, 300, { type: 'square', to: 210, dur: 0.16, gain: 0.12, attack: 0.003, lp: 1100, lpTo: 500 });
          this.osc(t + 0.17, 260, { type: 'square', to: 190, dur: 0.18, gain: 0.11, attack: 0.003, lp: 1000, lpTo: 460 });
        },
        // 喊 CABO：上升噪声 + 主和弦钟 + 底鼓 + 闪光，时长对齐横幅的 2.1s
        cabo(t) {
          this.riser(t, 0.52);
          const hit = t + 0.52;
          [62, 66, 69, 74, 76].forEach((m, i) => {
            this.bell(hit + i * 0.028, m + 12, { gain: 0.13 - i * 0.008, dur: 2.2, send: 0.6, pan: (i - 2) * 0.24 });
          });
          this.thud(hit, { gain: 0.34, from: 130, to: 48, dur: 0.34 });
          this.sparkle(hit + 0.04, 7, 4217);
          this.duck(0.28, 1.5);
        },
        start(t) {
          [62, 66, 69, 74].forEach((m, i) => this.pluck(t + i * 0.075, m, { gain: 0.15, dur: 0.8, send: 0.3, pan: (i - 1.5) * 0.2 }));
          this.duck(0.5, 1.1);
        },
        score(t) {
          [74, 78, 81].forEach((m, i) => this.pluck(t + i * 0.115, m, { gain: 0.12, dur: 0.6, send: 0.3, pan: -0.2 + i * 0.2 }));
          this.duck(0.55, 1.6);
        },
        tick(t, i) {
          this.pluck(t, 76 + ((i || 0) % 3) * 2, { gain: 0.07, dur: 0.16, transient: false });
        },
        win(t) {
          [62, 66, 69, 74, 78, 81].forEach((m, i) => this.pluck(t + i * 0.085, m, { gain: 0.16, dur: 0.9, send: 0.35, pan: (i % 2 ? 0.2 : -0.2) }));
          [74, 78, 81, 86].forEach((m, i) => this.bell(t + 0.52 + i * 0.02, m, { gain: 0.1, dur: 2.4, send: 0.6, pan: (i - 1.5) * 0.22 }));
          this.sparkle(t + 0.55, 9, 991);
          this.duck(0.22, 2.2);
        },
        lose(t) {
          [74, 71, 69, 66].forEach((m, i) => this.pluck(t + i * 0.15, m, { gain: 0.13, dur: 1.1, send: 0.4, pan: (i - 1.5) * 0.16 }));
          this.osc(t + 0.6, hz(38), { type: 'triangle', gain: 0.1, dur: 1.4, attack: 0.08, lp: 400 });
          this.duck(0.3, 2);
        },
      });
    }

    riser(t, dur) {
      this.noise(t, { dur: dur, gain: 0.07, bp: 600, sweep: 4200, q: 1.6, attack: dur * 0.75, send: 0.3 });
      this.osc(t, 220, { type: 'sine', to: 880, dur: dur, gain: 0.08, attack: dur * 0.7, send: 0.25 });
    }

    /* ---------------- 配乐序列器 ---------------- */

    setMode(mode) {
      if (this.mode === mode) return;
      this.mode = mode;
      this.tempoTarget = TEMPO[mode] || TEMPO.table;
    }

    // AudioContext 的时钟是唯一的真相；setInterval 只负责提前把音符排上去
    _pump() {
      if (this.offline || !this.ok) return;
      const ctx = this.ctx;
      if (ctx.state !== 'running') return;
      if (this.nextAt === undefined) {
        this.nextAt = ctx.currentTime + 0.12;
        return;
      }
      // 后台标签页里 setInterval 被节流，落后太多就重新对齐，避免一次性补出一大堆音符
      if (this.nextAt < ctx.currentTime - 0.2) this.nextAt = ctx.currentTime + 0.05;

      while (this.nextAt < ctx.currentTime + 0.16) {
        if (this.musicOn && !this.prefs.muted) this._scheduleStep(this.step, this.nextAt);
        const beat = 60 / this.bpm;
        this.nextAt += beat / 4;
        this.bpm += (this.tempoTarget - this.bpm) * 0.012;
        this.step++;
        if (this.step >= STEPS_PER_BAR * TOTAL_BARS) {
          this.step = 0;
          this.loop++;
        }
      }
    }

    _chordOf(bar) {
      return CHORDS[FORM[bar < 8 ? 0 : 1][bar % 8]];
    }

    _snap(m) {
      let best = SCALE[0];
      for (const s of SCALE) if (Math.abs(s - m) < Math.abs(best - m)) best = s;
      return best;
    }

    // 每次进新的一小节重新摇一次旋律，音高永远落在当前和弦内，
    // 但节奏和走向会变——听感是「同一首曲子」而不是随机音符。
    _planBar(bar) {
      const chord = this._chordOf(bar);
      const rnd = mulberry32(this.loop * 977 + bar * 31 + 7);
      const notes = [];
      const tension = this.mode === 'tension';
      const menu = this.mode === 'menu';
      const last = bar % 8 === 7;

      if (menu) {
        const idx = 2 + (rnd() < 0.5 ? 1 : 0);
        notes.push({ st: 0, m: chord.mel[idx], dur: 5.5, vel: 0.5, kind: 'bell' });
        if (rnd() < 0.5) notes.push({ st: 6, m: chord.mel[clamp(idx + (rnd() < 0.5 ? 1 : -1), 0, 4)], dur: 4, vel: 0.36, kind: 'bell' });
      } else {
        const motif = MOTIF[(bar >> 1) % 4];
        const pat = tension
          ? PATTERNS[bar % 2 === 0 ? 0 : 3]
          : PATTERNS[Math.floor(rnd() * (last ? 5 : PATTERNS.length))];
        for (let i = 0; i < pat.st.length; i++) {
          let m = chord.mel[clamp(motif[pat.mo[i]] || 0, 0, 4)];
          if (!tension && rnd() < 0.16) m += 12;
          if (!tension && rnd() < 0.14) m = this._snap(m + (rnd() < 0.5 ? 1 : -1));
          if (tension) m -= 12;
          const next = pat.st[i + 1] === undefined ? STEPS_PER_BAR : pat.st[i + 1];
          notes.push({
            st: pat.st[i],
            m: clamp(m, 53, 90),
            dur: Math.max(1, next - pat.st[i]) * (last && i === pat.st.length - 1 ? 2.4 : 0.94),
            vel: (i === 0 ? 0.95 : 0.7 + rnd() * 0.3) * (tension ? 0.72 : 1),
            kind: tension ? 'kalimba' : 'box',
          });
          if (!tension && rnd() < 0.18 && i < pat.st.length - 1) {
            notes.push({ st: pat.st[i] + 2, m: this._snap(m + 1), dur: 1, vel: 0.4, kind: 'box' });
          }
        }
      }
      notes.sort((a, b) => a.st - b.st);
      return { chord: chord, notes: notes, accent: rnd() };
    }

    _scheduleStep(step, time) {
      const s = step % STEPS_PER_BAR;
      const bar = Math.floor(step / STEPS_PER_BAR);
      if (s === 0) this.plan = this._planBar(bar);
      const plan = this.plan;
      if (!plan) return;
      const chord = plan.chord;
      const six = 60 / this.bpm / 4;
      const M = 'music';

      // 圆舞曲低音：一拍根音、二三拍五音
      if (s === 0) this.bassNote(time, chord.bass, { gain: 0.3, dur: six * 5, bus: M, send: 0.08, pan: 0 });
      if (s === 3) this.bassNote(time, chord.bass + 7, { gain: 0.18, dur: six * 3.4, bus: M, send: 0.08, pan: -0.16 });
      if (s === 6) this.bassNote(time, chord.bass + 7, { gain: 0.16, dur: six * 3.4, bus: M, send: 0.08, pan: 0.16 });
      if (this.mode === 'tension' && s === 9) this.bassNote(time, chord.bass, { gain: 0.16, dur: six * 2, bus: M, send: 0.05 });

      // 中声部：三拍各弹一次和弦，音量压低当织体
      const tri = chord.tri;
      if (s === 0 || s === 3 || s === 6) {
        const g = this.mode === 'menu' ? 0.055 : 0.045;
        tri.forEach((m, i) => this.pluck(time + i * 0.014, m, { gain: g, dur: six * 4, bus: M, send: 0.12, pan: (i - 1) * 0.28, transient: false, lp: 2600 }));
      }

      for (const n of plan.notes) {
        if (n.st !== s) continue;
        const dur = n.dur * six;
        const pan = ((n.m % 3) - 1) * 0.24;
        if (n.kind === 'bell') {
          this.bell(time, n.m, { gain: 0.1 * n.vel, dur: dur * 1.5, bus: M, send: REV.menu, pan: pan });
        } else if (n.kind === 'kalimba') {
          this.pluck(time, n.m, { gain: 0.13 * n.vel, dur: dur, bus: M, send: REV.tension, pan: pan, lp: 3000, parts: [[1, 1, 1], [2.0, 0.4, 0.5], [3.93, 0.1, 0.3]] });
        } else {
          this.pluck(time, n.m, { gain: 0.14 * n.vel, dur: dur, bus: M, send: REV.table, pan: pan });
        }
      }

      // 沙锤只在桌面模式下给空气感
      if (this.mode === 'table' && (s === 2 || s === 5 || s === 8 || s === 11)) {
        this.noise(time, { dur: 0.035, gain: s === 5 || s === 11 ? 0.03 : 0.016, bp: 6200, q: 1.2, bus: M, send: 0.1, pan: s % 6 === 2 ? 0.4 : -0.4 });
      }
      if (this.mode === 'tension' && (s === 0 || s === 6)) {
        this.osc(time, 72, { type: 'sine', to: 46, dur: 0.18, gain: 0.16, attack: 0.004, bus: M });
      }
    }

    /* ---------------- 控制界面 ---------------- */
  }

  window.CaboAudio = CaboAudio;

  /* ---------- 音量控件：建在引擎之外，首屏没有用户手势也能看到 ---------- */

  function mountControls() {
    document.querySelectorAll('[data-snd-mount]').forEach((slot) => {
      if (slot.dataset.sndDone === '1') return;
      slot.dataset.sndDone = '1';
      slot.appendChild(makeWidget());
    });
    syncWidgets();
  }

  function makeWidget() {
    const root = document.createElement('div');
    root.className = 'snd';

    const btn = document.createElement('button');
    btn.className = 'snd-btn ghost';
    btn.type = 'button';
    btn.title = '音乐与音效';
    btn.setAttribute('aria-label', '音乐与音效');
    btn.innerHTML =
      '<svg viewBox="0 0 24 24" aria-hidden="true"><path class="ic-cone" d="M4 9.5h3.2L12 5.6v12.8L7.2 14.5H4z"/>' +
      '<path class="ic-w1" d="M15.4 9.2a4 4 0 0 1 0 5.6"/>' +
      '<path class="ic-w2" d="M18 6.6a7.6 7.6 0 0 1 0 10.8"/>' +
      '<line class="ic-x" x1="15" y1="9.5" x2="20.5" y2="15"/></svg>';
    root.appendChild(btn);

    const pop = document.createElement('div');
    pop.className = 'snd-pop';
    pop.hidden = true;

    const slider = (label, key) => {
      const row = document.createElement('label');
      row.className = 'snd-row';
      const t = document.createElement('span');
      t.textContent = label;
      const r = document.createElement('input');
      r.type = 'range';
      r.min = '0';
      r.max = '100';
      r.className = 'snd-range';
      r.dataset.key = key;
      r.value = String(Math.round(prefs[key] * 100));
      r.addEventListener('input', () => setVolume(key, Number(r.value) / 100));
      const v = document.createElement('b');
      v.textContent = r.value + '%';
      row.appendChild(t);
      row.appendChild(r);
      row.appendChild(v);
      return row;
    };
    pop.appendChild(slider('音乐', 'music'));
    pop.appendChild(slider('音效', 'sfx'));

    const mute = document.createElement('button');
    mute.className = 'snd-mute';
    mute.type = 'button';
    mute.textContent = '静音';
    mute.addEventListener('click', () => setMuted(!prefs.muted));
    pop.appendChild(mute);
    root.appendChild(pop);

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = pop.hidden;
      closeAll();
      if (open) {
        pop.hidden = false;
        btn.classList.add('on');
      }
    });
    pop.addEventListener('click', (e) => e.stopPropagation());

    widgets.push({ root, btn, pop, mute, ranges: pop.querySelectorAll('.snd-range') });
    return root;
  }

  function closeAll() {
    document.querySelectorAll('.snd-pop').forEach((p) => (p.hidden = true));
    document.querySelectorAll('.snd-btn').forEach((b) => b.classList.remove('on'));
  }

  function syncWidgets() {
    for (const w of widgets) {
      w.root.classList.toggle('muted', prefs.muted);
      w.btn.classList.toggle('muted', prefs.muted);
      w.mute.textContent = prefs.muted ? '取消静音' : '静音';
      w.ranges.forEach((r) => {
        r.value = String(Math.round(prefs[r.dataset.key] * 100));
        r.parentNode.querySelector('b').textContent = r.value + '%';
      });
    }
  }

  /* ---------------- 单例与解锁 ---------------- */

  function ensure() {
    if (engine) return engine;
    const Ctor = window.AudioContext || window.webkitAudioContext;
    if (!Ctor) return null;
    try {
      engine = new CaboAudio(new Ctor());
    } catch (e) {
      console.warn('[cabo audio] 初始化失败', e);
      return null;
    }
    window.caboAudio = engine;
    return engine;
  }

  // 浏览器要求音频必须由用户手势启动；这里在捕获阶段抢先建好上下文，
  // 这样「开始游戏」那一下的点击音也能发声。
  function unlock() {
    const e = ensure();
    if (e && e.ctx.state === 'suspended') e.ctx.resume();
    window.removeEventListener('pointerdown', unlock, true);
    window.removeEventListener('keydown', unlock, true);
  }
  window.addEventListener('pointerdown', unlock, true);
  window.addEventListener('keydown', unlock, true);

  document.addEventListener('click', (ev) => {
    if (!ev.target.closest || !ev.target.closest('.snd-btn')) closeAll();
  });

  // 控件不等手势，脚本一加载（index.html 里挂在 body 末尾，DOM 已就绪）就上屏
  mountControls();

  // app.js 通过它发声；音频不可用时静默降级，绝不影响牌局
  window.snd = function (name, arg) {
    const e = engine || ensure();
    if (e) e.play(name, arg);
  };
  window.sndMode = function (mode) {
    if (engine) engine.setMode(mode);
  };
})();
