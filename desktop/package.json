{
  "name": "cabo-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "CABO Electron desktop shell",
  "main": "main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "node scripts/build.cjs",
    "lint": "node scripts/lint.cjs",
    "test": "node --test tests/*.test.mjs",
    "coverage": "node scripts/coverage.cjs",
    "test:smoke": "node scripts/smoke.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  },
  "build": {
    "appId": "com.dhktig.cabo",
    "productName": "CABO",
    "artifactName": "cabo.exe",
    "directories": {
      "output": "../artifacts/electron"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".electron/cabo-server.exe",
        "to": "cabo-server.exe"
      }
    ],
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "toolsets": {
      "nsis": "1.2.1"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../cmd/cabo/cabo.ico"
    },
    "nsis": {
      "artifactName": "CABO-${version}-windows-x64-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "CABO",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "cabo.exe"
    }
  }
}
